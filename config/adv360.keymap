#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp PG_DN &kp N1    &mt N2 LBKT &mt N3 LBRC &mt N4 LPAR &mt N5 GRAVE &to 1                                                        &mo 3      &mt N6 BSLH &mt N7 RPAR &mt N8 RBRC &mt N9 RBKT &kp N0   &kp PG_UP
        &kp ESC   &kp Q     &kp W       &kp E       &kp R       &kp T        &none                                                         &none      &kp Y       &kp U       &kp I       &kp O       &kp P    &kp BSLH
        &kp TAB   &kp A     &kp S       &kp D       &kp F       &kp G        &none    &kp LCTRL       &kp LEFT_GUI  &kp RCTRL    &kp LALT  &none      &kp H       &kp J       &kp K       &kp L       &kp SEMI &kp SQT
        &kp MINUS &kp Z     &kp X       &kp C       &kp V       &kp B                                 &kp LALT      &kp LEFT_GUI                      &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH &kp EQUAL
        &mo 2     &kp GRAVE &kp CAPS    &kp LEFT    &kp RIGHT                &kp BSPC &kp LEFT_SHIFT  &mo 2         &kp DELETE   &kp ENTER &kp SPACE              &kp UP      &kp DOWN    &kp LBKT    &kp RBKT &mo 2
      >;
    };
    linux {
      display-name = "Linux";
      bindings = <
        &kp PG_DN &kp N1    &mt N2 LBKT &mt N3 LBRC &mt N4 LPAR &mt N5 GRAVE &to 0                                                       &mo 3      &mt N6 BSLH &mt N7 RPAR &mt N8 RBRC &mt N9 RBKT &kp N0   &kp PG_UP
        &kp ESC   &kp Q     &kp W       &kp E       &kp R       &kp T        &none                                                        &none      &kp Y       &kp U       &kp I       &kp O       &kp P    &kp BSLH
        &kp TAB   &kp A     &kp S       &kp D       &kp F       &kp G        &none    &kp LCTRL       &kp LALT     &kp RCTRL    &kp LALT  &none      &kp H       &kp J       &kp K       &kp L       &kp SEMI &kp SQT
        &kp MINUS &kp Z     &kp X       &kp C       &kp V       &kp B                                 &kp LEFT_GUI &kp LEFT_GUI                      &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH &kp EQUAL
        &mo 2     &kp GRAVE &kp CAPS    &kp LEFT    &kp RIGHT                &kp BSPC &kp LEFT_SHIFT  &mo 2        &kp DELETE   &kp ENTER &kp SPACE              &kp UP      &kp DOWN    &kp LBKT    &kp RBKT &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6  &none                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
